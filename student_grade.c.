
#include <stdio.h>

int main() {
    char name[50];
    int rollNo, marks[5], total = 0;
    float average;
    int i;

    printf("STUDENT GRADE MANAGEMENT SYSTEM\n");

    printf("Enter student name: ");
    scanf(" %49[^\n]", name);

    printf("Enter roll number: ");
    scanf("%d", &rollNo);

    for (i = 0; i < 5; i++) {
        printf("Enter marks for subject %d (0-100): ", i + 1);
        scanf("%d", &marks[i]);

        if (marks[i] < 0 || marks[i] > 100) {
            printf("Invalid marks! Please enter 0 to 100.\n");
            return 0;
        }

        total += marks[i];
    }

    average = total / 5.0f;

    printf("\n--- STUDENT RESULT ---\n");
    printf("Name: %s\n", name);
    printf("Roll Number: %d\n", rollNo);
    printf("Total Marks: %d/500\n", total);
    printf("Average: %.2f\n", average);

    if (average >= 90)
        printf("Grade: A\n");
    else if (average >= 75)
        printf("Grade: B\n");
    else if (average >= 60)
        printf("Grade: C\n");
    else if (average >= 40)
        printf("Grade: D\n");
    else
        printf("Grade: Fail\n");

    return 0;
}
